{
  "name": "furkan-sarica-portfolio",
  "version": "2.5.0",
  "private": true,
  "description": "Furkan SARICA - Enterprise AI & DevOps Portfolio and Autonomous AI Terminal",
  "scripts": {
    "dev": "python3 -m http.server 8080",
    "serve": "python3 -m http.server 8080",
    "test": "npm run test:integrity && npm run test:syntax && npm run test:unit && npm run test:smoke",
    "test:integrity": "python3 scripts/verify-integrity.py",
    "test:syntax": "python3 scripts/verify-javascript.py",
    "test:smoke": "playwright test",
    "security:scan": "python3 scripts/verify-integrity.py",
    "test:unit": "node --test tests/unit/*.test.cjs",
    "test:production": "playwright test tests/smoke.spec.cjs --project=masaustu --project=mobil"
  },
  "keywords": [
    "portfolio",
    "ai-agent",
    "rag",
    "cloudflare-workers",
    "pwa",
    "devops",
    "fastapi",
    "kubernetes"
  ],
  "author": "Furkan SARICA (https://github.com/furkan-sarica)",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
